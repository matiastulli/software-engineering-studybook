  "cards": [
    {
      "dot": "amber",
      "title": "Change log → current state",
      "items": [
        "S3 keeps every change, append-only",
        "MERGE keeps the latest row per key",
        "Order by log position, never wall clock"
      ]
    },
    {
      "dot": "rose",
      "title": "The slot trap",
      "items": [
        "A stalled consumer pins WAL on the primary",
        "Alarm on replication slot lag",
        "Disk fills → primary goes down"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reprocessing",
      "items": [
        "Bad transform → re-run from S3 raw",
        "No re-extract from the primary",
        "Schema changes land additive in RAW first"
      ]
    }
